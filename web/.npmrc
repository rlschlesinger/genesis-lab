# npm 10 crashes ("Cannot read properties of null (reading 'edgesOut')") resolving an optional
# peer: @vitest/mocker accepts msw ^2 but msw is now 3.x. We don't use msw. legacy-peer-deps
# stops npm auto-resolving peers; every peer we need (vite, typescript, @types/node) is listed
# explicitly in package.json, and `npm ls` is checked for unmet peers after each install.
# Remove this line once npm or vitest no longer trips over it.
legacy-peer-deps=true
